# === 密钥与环境变量 ===
.env
*.env
.env.local
.env.*.local

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === 数据与产物(不推 GitHub) ===
data/
*.pdf
*.png
*.jpg
*.jpeg
*.docx
*.pptx
*.doc
*.ppt

# === OCR 工作流数据(md-input 输入 / md-output 输出 / md-images 图片) ===
pdf_tools/md-image-extractor/md-input/*
pdf_tools/md-image-extractor/md-output/*
pdf_tools/md-image-extractor/md-images/*
!pdf_tools/md-image-extractor/md-input/.gitkeep
!pdf_tools/md-image-extractor/md-output/.gitkeep
!pdf_tools/md-image-extractor/md-images/.gitkeep

# === files-to-md 材料与产物(输入 PDF 已被 *.pdf 忽略,输出 md 产物也不入库) ===
pdf_tools/files-to-md/material-input/*
pdf_tools/files-to-md/material_output/*
!pdf_tools/files-to-md/material-input/.gitkeep
!pdf_tools/files-to-md/material_output/.gitkeep

# === knowledge_pipeline 材料数据(subject 下四类材料,只保留说明文件) ===
knowledge_pipeline/**/subject/*/*
!knowledge_pipeline/**/subject/*/.gitkeep
!knowledge_pipeline/**/subject/*/learning_chapter.txt
!knowledge_pipeline/**/subject/*/medical_learning.md

# === 运行时 ===
ao-output/
runs/
logs/
*.log

# === 编辑器/系统 ===
.vscode/
.idea/
.DS_Store
Thumbs.db
